<script>
  function switchTab(btn) {
    const tab = btn.dataset.tab;

    // Reset all buttons
    document.querySelectorAll('#feat-tabs button').forEach(b => {
      b.style.background = 'transparent';
      b.style.color = 'rgba(248,243,185,.55)';
      b.style.borderColor = 'rgba(144,169,85,.2)';
    });

    // Active button
    btn.style.background = '#FCA311';
    btn.style.color = '#132A13';
    btn.style.borderColor = '#FCA311';

    // Hide all panels
    document.querySelectorAll('[data-panel]').forEach(p => {
      (p as HTMLElement).style.display = 'none';
    });

    // Show target panel
    const panel = document.querySelector(`[data-panel="${tab}"]`);
    if (panel) (panel as HTMLElement).style.display = 'block';
  }

  // Expose globally for inline onclick
  (window as any).switchTab = switchTab;
</script>


