---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout>
<Nav current="home" />


<!-- ══════════════════════════════════════════════
     HERO
══════════════════════════════════════════════ -->
<section class="grid-bg" style="position:relative;min-height:100vh;background-color:#132A13;display:flex;align-items:center;padding-top:64px;overflow:hidden;">

  <!-- Glow -->
  <div style="position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 65% 55% at 72% 50%, rgba(252,163,17,0.07) 0%, transparent 68%);"></div>

  <div class="wrap" style="position:relative;z-index:2;padding-top:5rem;padding-bottom:6rem;width:100%;">


    <!-- Headline -->
    <h1 class="fu2" style="font-size:clamp(3rem,7vw,5.5rem);color:#F8F3B9;margin-bottom:1.5rem;max-width:700px;">
      Tu restaurante<br/>
      no debería de<br/>
      depender de<br/>
      <span style="color:#FCA311;position:relative;">internet<span style="position:absolute;bottom:4px;left:0;right:0;height:3px;background:#FCA311;opacity:.35;border-radius:2px;"></span></span> para<br/>
      cobrar
    </h1>

    <!-- Sub -->
    <p class="fu3" style="font-size:1.1rem;color:rgba(248,243,185,.72);max-width:500px;margin-bottom:2.5rem;line-height:1.75;">
      hi-POS funciona aunque se caiga el wifi, aunque se vaya la luz del router,
      aunque tu proveedor "tenga mantenimiento". Sin rentas mensuales. Sin sorpresas.
      <strong style="color:rgba(248,243,185,.95);font-weight:500;">Tuyo para siempre.</strong>
    </p>

    <!-- CTAs -->
    <div class="fu4" style="display:flex;flex-wrap:wrap;gap:.875rem;margin-bottom:2.75rem;">
      <a href="#demo" class="btn btn-primary">Quiero ver la demo</a>
      <a href="#como-funciona" class="btn btn-secondary">¿Cómo funciona?</a>
    </div>

    <!-- Badge -->
    <div class="fu5" style="display:inline-flex;align-items:center;gap:.6rem;background:rgba(144,169,85,.1);border:1px solid rgba(144,169,85,.25);padding:.5rem 1.1rem;border-radius:3px;">
      <span style="font-family:'IBM Plex Mono',monospace;font-size:.72rem;color:#90A955;">Funciona sin internet. Siempre.</span>
    </div>

  </div>

  <!-- Bottom line -->
  <div style="position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:1px;height:72px;background:linear-gradient(to bottom, transparent, rgba(144,169,85,.5));"></div>
</section>


<!-- ══════════════════════════════════════════════
     PAIN
══════════════════════════════════════════════ -->
<section style="position:relative;background:#1e3d1e;padding:7rem 0;">
  <div class="divider-top"></div>
  <div class="wrap">

    <h2 style="font-size:clamp(1.9rem,4vw,3rem);color:#F8F3B9;margin-bottom:3rem;max-width:500px;">
      ¿Cuánto llevas pagando<br/>
      por un sistema que no<br/>
      te pertenece?
    </h2>

    <div class="pain-grid" style="margin-bottom:3rem;">
      {[
        'Pagas cada mes aunque no vendas nada',
        'Si no hay internet, no hay ventas — literal',
        'Para cancelar una comanda necesitas llamar a soporte',
        'Tus datos están en servidores de alguien más',
        'El precio sube y tú no puedes hacer nada',
      ].map(text => (
        <div style="display:flex;align-items:flex-start;gap:1rem;background:rgba(19,42,19,.55);border:1px solid rgba(252,163,17,.12);border-left:3px solid #FCA311;border-radius:5px;padding:1.1rem 1.4rem;">
          <span style="font-family:'IBM Plex Mono',monospace;font-weight:600;color:#FCA311;font-size:1.1rem;line-height:1;flex-shrink:0;margin-top:2px;">✕</span>
          <p style="color:rgba(248,243,185,.75);font-size:.9rem;line-height:1.55;">{text}</p>
        </div>
      ))}
    </div>

    <div style="background:rgba(252,163,17,.05);border:1px solid rgba(252,163,17,.2);border-radius:8px;padding:1.75rem 2rem;max-width:640px;">
      <p style="color:rgba(248,243,185,.6);font-size:1rem;margin-bottom:.5rem;">Los SaaS de POS están diseñados para que dependas de ellos.</p>
      <p style="font-family:'IBM Plex Mono',monospace;font-weight:600;color:#F8F3B9;font-size:1.05rem;">hi-POS está diseñado para que seas libre.</p>
    </div>

  </div>
</section>


<!-- ══════════════════════════════════════════════
     WHAT IS
══════════════════════════════════════════════ -->
<section style="background:#132A13;padding:8rem 0;" id="como-funciona">
  <div class="wrap">
    <div style="max-width:640px;">
      <p style="font-family:'IBM Plex Mono',monospace;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:#90A955;margin-bottom:1.5rem;opacity:.8;">¿Que es Hi-POS?</p>
      <h2 style="font-size:clamp(2.2rem,5vw,4rem);color:#F8F3B9;margin-bottom:1.5rem;">
        Un POS completo.<br/>
        Una sola vez.<br/>
        <span style="color:#FCA311;">Sin rentas.</span>
      </h2>
      <p style="font-size:1.05rem;color:rgba(248,243,185,.65);line-height:1.8;max-width:520px;">
        hi-POS es el sistema punto de venta para restaurantes y pizzerías que vive en tu
        máquina, no en la nube de alguien más. Pagas una licencia, lo instalas y es tuyo para
        siempre.
      </p>
    </div>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     FEATURES
══════════════════════════════════════════════ -->
<section style="background:#132A13;padding-bottom:8rem;">
  <div class="wrap">
    <h2 style="font-size:clamp(1.8rem,4vw,2.8rem);color:#F8F3B9;margin-bottom:2.75rem;">
      Las 6 razones por las<br/>que cambia todo
    </h2>

    <div class="features-grid">

      <!-- Highlight -->
      <div class="fcard fcard-amber" style="background:#1e3d1e;border:1px solid rgba(252,163,17,.25);border-radius:8px;padding:1.75rem 1.6rem;">
        <div style="color:#FCA311;margin-bottom:1.25rem;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="1" y1="1" x2="23" y2="23"/>
            <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/><path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"/>
            <path d="M10.71 5.05A16 16 0 0 1 22.56 9"/><path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"/>
            <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>
          </svg>
        </div>
        <h3 style="font-size:1rem;color:#F8F3B9;margin-bottom:.45rem;">Offline-First</h3>
        <p style="font-size:.875rem;color:rgba(248,243,185,.55);line-height:1.6;">Funciona sin internet. Siempre. Sin excusas.</p>
        <span style="position:absolute;top:1rem;right:1rem;font-family:'IBM Plex Mono',monospace;font-size:.62rem;font-weight:600;color:#FCA311;background:rgba(252,163,17,.12);padding:.2rem .5rem;border-radius:2px;letter-spacing:.06em;text-transform:uppercase;">Core</span>
      </div>

      <!-- Licencia perpetua -->
      <div class="fcard" style="background:#1e3d1e;border:1px solid rgba(144,169,85,.15);border-radius:8px;padding:1.75rem 1.6rem;">
        <div style="color:#90A955;margin-bottom:1.25rem;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
          </svg>
        </div>
        <h3 style="font-size:1rem;color:#F8F3B9;margin-bottom:.45rem;">Licencia perpetua</h3>
        <p style="font-size:.875rem;color:rgba(248,243,185,.55);line-height:1.6;">Lo compras una vez y es tuyo para siempre.</p>
      </div>

      <!-- Restaurantes -->
      <div class="fcard" style="background:#1e3d1e;border:1px solid rgba(144,169,85,.15);border-radius:8px;padding:1.75rem 1.6rem;">
        <div style="color:#90A955;margin-bottom:1.25rem;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 11l19-9-9 19-2-8-8-2z"/>
          </svg>
        </div>
        <h3 style="font-size:1rem;color:#F8F3B9;margin-bottom:.45rem;">Hecho para restaurantes</h3>
        <p style="font-size:.875rem;color:rgba(248,243,185,.55);line-height:1.6;">Mesas, comandas, cocina y corte de caja.</p>
      </div>

      <!-- Inventario -->
      <div class="fcard" style="background:#1e3d1e;border:1px solid rgba(144,169,85,.15);border-radius:8px;padding:1.75rem 1.6rem;">
        <div style="color:#90A955;margin-bottom:1.25rem;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
          </svg>
        </div>
        <h3 style="font-size:1rem;color:#F8F3B9;margin-bottom:.45rem;">Inventario inteligente</h3>
        <p style="font-size:.875rem;color:rgba(248,243,185,.55);line-height:1.6;">Descuenta materia prima automáticamente al vender.</p>
      </div>

      <!-- Reportes -->
      <div class="fcard" style="background:#1e3d1e;border:1px solid rgba(144,169,85,.15);border-radius:8px;padding:1.75rem 1.6rem;">
        <div style="color:#90A955;margin-bottom:1.25rem;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
        </div>
        <h3 style="font-size:1rem;color:#F8F3B9;margin-bottom:.45rem;">Reportes y corte</h3>
        <p style="font-size:.875rem;color:rgba(248,243,185,.55);line-height:1.6;">Corte de caja diario y exportación a Excel.</p>
      </div>

      <!-- Acceso -->
      <div class="fcard" style="background:#1e3d1e;border:1px solid rgba(144,169,85,.15);border-radius:8px;padding:1.75rem 1.6rem;">
        <div style="color:#90A955;margin-bottom:1.25rem;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2"/>
            <path d="M7 11V7a5 5 0 0110 0v4"/>
          </svg>
        </div>
        <h3 style="font-size:1rem;color:#F8F3B9;margin-bottom:.45rem;">Control de acceso</h3>
        <p style="font-size:.875rem;color:rgba(248,243,185,.55);line-height:1.6;">Roles, PIN y permisos por usuario.</p>
      </div>

    </div>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     FUNCIONALIDADES V.01
══════════════════════════════════════════════ -->
<section style="position:relative;background:#1e3d1e;padding:7rem 0;" id="funcionalidades">
  <div class="divider-top"></div>

  <!-- Ambient glow -->
  <div style="position:absolute;left:-8rem;top:30%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(252,163,17,0.05) 0%,transparent 70%);pointer-events:none;"></div>

  <div class="wrap">

    <!-- Header -->
    <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:1.5rem;margin-bottom:3.5rem;">
      <div>
        <p style="font-family:'IBM Plex Mono',monospace;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:#90A955;margin-bottom:1rem;opacity:.8;">Versión 0.1</p>
        <h2 style="font-size:clamp(1.8rem,4vw,2.8rem);color:#F8F3B9;max-width:560px;">
          Todo lo que necesitas<br/>
          para abrir el negocio<br/>
          <span style="color:#FCA311;">desde el primer día</span>
        </h2>
      </div>
      <div style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(144,169,85,.1);border:1px solid rgba(144,169,85,.25);padding:.55rem 1.1rem;border-radius:3px;white-space:nowrap;">
        <span style="width:7px;height:7px;border-radius:50%;background:#90A955;display:inline-block;flex-shrink:0;"></span>
        <span style="font-family:'IBM Plex Mono',monospace;font-size:.7rem;color:#90A955;">18 funcionalidades incluidas</span>
      </div>
    </div>

    <!-- Tab buttons -->
    <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:2rem;" id="feat-tabs">
      {[
        ['cuentas', 'División de cuentas'],
        ['promos', 'Promociones'],
        ['delivery', 'Delivery'],
        ['propinas', 'Propinas'],
      ].map(([id, emoji, label], i) => (
        <button
          data-tab={id}
          onclick="switchTab(this)"
          style={`display:inline-flex;align-items:center;gap:.55rem;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:.78rem;padding:.6rem 1.2rem;border-radius:5px;border:1px solid;cursor:pointer;transition:all .2s ease;${i===0 ? 'background:#FCA311;color:#132A13;border-color:#FCA311;' : 'background:transparent;color:rgba(248,243,185,.55);border-color:rgba(144,169,85,.2);'}`}
        >
          <span>{emoji}</span>{label}
        </button>
      ))}
    </div>

    <!-- ── TAB: División de cuentas ── -->
    <div data-panel="cuentas" style="display:block;">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;">

        {[
          {
            cu: 'CU-32',
            title: 'Dividir cuenta equitativa',
            desc: 'El sistema divide el total en partes iguales automáticamente. Indicas cuántas personas y listo — cada quien sabe exactamente cuánto paga.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>`,
          },
          {
            cu: 'CU-33',
            title: 'Dividir por producto',
            desc: 'Selecciona qué platillos paga cada persona. Perfecto para mesas donde cada quien pide diferente y quiere pagar solo lo suyo.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="12" y2="16"/></svg>`,
          },
          {
            cu: 'CU-34',
            title: 'Pago mixto',
            desc: 'Una parte en efectivo, el resto con tarjeta. O cualquier combinación de métodos. Sin malabarismos ni cuentas separadas en la caja.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
          },
          {
            cu: 'CU-68',
            title: 'Transferir a otra mesa',
            desc: 'Los comensales se juntaron o se separaron. Mueve productos de una orden a otra mesa en segundos, sin cancelar ni rehacer nada.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 014-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg>`,
          },
        ].map(f => (
          <div class="fcard" style="background:#132A13;border:1px solid rgba(144,169,85,.15);border-radius:8px;padding:1.6rem;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
              <div style="color:#90A955;" set:html={f.icon}></div>
              <span style="font-family:'IBM Plex Mono',monospace;font-size:.6rem;font-weight:600;color:rgba(144,169,85,.5);letter-spacing:.06em;">{f.cu}</span>
            </div>
            <h3 style="font-size:.95rem;color:#F8F3B9;margin-bottom:.5rem;">{f.title}</h3>
            <p style="font-size:.855rem;color:rgba(248,243,185,.55);line-height:1.6;">{f.desc}</p>
          </div>
        ))}

      </div>
    </div>

    <!-- ── TAB: Promociones ── -->
    <div data-panel="promos" style="display:none;">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;">

        {[
          {
            cu: 'CU-35',
            title: 'Crear promoción',
            desc: 'Configura 2x1, descuento en porcentaje o paquete a precio fijo. Defines los días y horas de vigencia para que solo aplique cuando tú decides.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>`,
          },
          {
            cu: 'CU-36',
            title: 'Editar o desactivar',
            desc: 'Modifica los parámetros de cualquier promoción en tiempo real o apágala con un clic para que deje de aplicar sin tener que eliminarla.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>`,
          },
          {
            cu: 'CU-37',
            title: 'Aplicación automática',
            desc: 'El sistema detecta si la orden cumple las reglas de una promo activa y recalcula el subtotal solo. Cero intervención manual del cajero.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
          },
          {
            cu: 'CU-38',
            title: 'Descuentos en ticket',
            desc: 'El ticket muestra claramente cuánto ahorró el cliente. Transparencia total para el cliente y para el cierre de caja del admin.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>`,
          },
          {
            cu: 'CU-69',
            title: 'Descuento manual (Cortesía)',
            desc: 'Aplica un descuento libre a un producto o a la cuenta total. Requiere PIN de autorización y motivo — control total sin dejar escapar cortesías sin registro.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>`,
          },
        ].map(f => (
          <div class="fcard" style="background:#132A13;border:1px solid rgba(144,169,85,.15);border-radius:8px;padding:1.6rem;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
              <div style="color:#90A955;" set:html={f.icon}></div>
              <span style="font-family:'IBM Plex Mono',monospace;font-size:.6rem;font-weight:600;color:rgba(144,169,85,.5);letter-spacing:.06em;">{f.cu}</span>
            </div>
            <h3 style="font-size:.95rem;color:#F8F3B9;margin-bottom:.5rem;">{f.title}</h3>
            <p style="font-size:.855rem;color:rgba(248,243,185,.55);line-height:1.6;">{f.desc}</p>
          </div>
        ))}

      </div>
    </div>

    <!-- ── TAB: Delivery ── -->
    <div data-panel="delivery" style="display:none;">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;">

        {[
          {
            cu: 'CU-70',
            title: 'Crear pedido a domicilio',
            desc: 'Abre una orden etiquetada como "A domicilio" o "Para llevar", separada de las mesas físicas. Sin mezclar flujos ni confundir a cocina.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
          },
          {
            cu: 'CU-71',
            title: 'Datos del cliente',
            desc: 'Nombre, teléfono, dirección e indicaciones especiales. Si el cliente ya ordenó antes, el sistema sugiere sus datos automáticamente al escribir su número.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
          },
          {
            cu: 'CU-72',
            title: 'Costo de envío',
            desc: 'Agrega un cargo por servicio a domicilio al total del pedido — tarifa fija configurada o monto manual por zona. Se refleja claro en el ticket.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>`,
          },
          {
            cu: 'CU-73',
            title: 'Asignar repartidor',
            desc: 'Selecciona de tu lista de repartidores registrados quién lleva el pedido. Trazabilidad de quién cargó cada orden para el cierre del turno.',
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
          },
          {
            cu: 'CU-74',
            title: 'Estado de envío',
            desc: 'Actualiza el ciclo de vida del pedido: En cocina → En camino → Entregado. Control visual del estado de todos los domicilios activos.',
